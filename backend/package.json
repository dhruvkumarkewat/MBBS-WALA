{
  "name": "mbbswala-backend",
  "version": "1.0.0",
  "description": "MBBS Wala Automated Counselling Intelligence Platform — Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "scraper:check": "tsx src/scrapers/cli.ts check",
    "scraper:sync": "tsx src/scrapers/cli.ts sync",
    "scraper:dry-run": "tsx src/scrapers/cli.ts dry-run",
    "worker": "tsx src/jobs/worker-runner.ts",
    "test": "vitest",
    "test:integration": "vitest --config vitest.integration.config.ts",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.1",
    "axios": "^1.9.0",
    "bullmq": "^5.34.0",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "cron": "^4.1.0",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "pdf-parse": "^1.1.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "playwright": "^1.52.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
